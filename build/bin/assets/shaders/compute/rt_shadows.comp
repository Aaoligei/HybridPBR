#version 460 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// 输出纹理：单通道 R (可见性 0.0 ~ 1.0)
layout(rgba32f, binding = 0) uniform image2D outputImage;

// G-Buffer 输入
uniform sampler2D gPosition;
uniform sampler2D gNormal;

// 场景数据 Uniforms
uniform int lightCount;
uniform vec3 lightPos; // 暂时只处理主光源(点光源或方向光位置)
uniform int width;
uniform int height;

// --- BVH 和 光线追踪结构 (与 path_tracing.comp 相同) ---
struct Ray {
    vec3 origin;
    float tMin;
    vec3 direction;
    float tMax;
};

struct BVHNode {
    vec3 min;
    float pad0;
    vec3 max;
    float pad1;
    int leftChild;
    int firstPrim;
    int primCount;
    int pad2;
};

struct Triangle {
    vec3 v0; float pad0;
    vec3 v1; float pad1;
    vec3 v2; float pad2;
    // ... 其他属性在阴影测试中不需要，但为了对齐保持结构一致
    vec3 n0; float pad3;
    vec3 n1; float pad4;
    vec3 n2; float pad5;
    vec3 t0; float padTangent0;
    vec3 t1; float padTangent1;
    vec3 t2; float padTangent2;
    vec2 uv0; vec2 pad6;
    vec2 uv1; vec2 pad7;
    vec2 uv2; vec2 pad8;
    uint materialIndex; uint pad9; uint pad10; uint pad11;
};

layout(std430, binding = 4) readonly buffer BVHNodes { BVHNode nodes[]; };
layout(std430, binding = 5) readonly buffer Triangles { Triangle triangles[]; };

// --- 简单的相交测试 (Any Hit) ---
bool IntersectTriangle(Ray ray, Triangle tri, float tMax) {
    vec3 edge1 = tri.v1 - tri.v0;
    vec3 edge2 = tri.v2 - tri.v0;
    vec3 h = cross(ray.direction, edge2);
    float a = dot(edge1, h);
    if (a > -1e-5 && a < 1e-5) return false;
    float f = 1.0 / a;
    vec3 s = ray.origin - tri.v0;
    float u = f * dot(s, h);
    if (u < 0.0 || u > 1.0) return false;
    vec3 q = cross(s, edge1);
    float v = f * dot(ray.direction, q);
    if (v < 0.0 || u + v > 1.0) return false;
    float t = f * dot(edge2, q);
    return (t > ray.tMin && t < tMax);
}

bool IntersectAABB(Ray ray, vec3 bMin, vec3 bMax, float tMax) {
    vec3 invDir = 1.0 / ray.direction;
    vec3 t0s = (bMin - ray.origin) * invDir;
    vec3 t1s = (bMax - ray.origin) * invDir;
    vec3 tsmaller = min(t0s, t1s);
    vec3 tbigger = max(t0s, t1s);
    float tmin = max(tsmaller.x, max(tsmaller.y, tsmaller.z));
    float tmax = min(tbigger.x, min(tbigger.y, tbigger.z));
    return (tmin < tmax && tmin < tMax && tmax > ray.tMin);
}

// 阴影射线只需要知道"是否遮挡"，不需要最近点，遇到遮挡立即返回
bool TraceShadowRay(Ray ray) {
    int stack[32];
    int stackPtr = 0;
    stack[stackPtr++] = 0; // Push root

    while (stackPtr > 0) {
        int nodeIndex = stack[--stackPtr];
        BVHNode node = nodes[nodeIndex];

        if (!IntersectAABB(ray, node.min, node.max, ray.tMax)) continue;

        if (node.primCount > 0) { // Leaf
            for (int i = 0; i < node.primCount; i++) {
                if (IntersectTriangle(ray, triangles[node.firstPrim + i], ray.tMax)) {
                    return true; // Hit something, shadowed
                }
            }
        } else { // Internal
            // 简单的优化：先访问近的子节点? 这里先简化直接压栈
            int left = node.leftChild;
            int right = node.firstPrim;
            if (left != -1) stack[stackPtr++] = left;
            if (right != -1) stack[stackPtr++] = right;
        }
    }
    return false; // No occlusion
}

void main() {
    ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
    if (pixel_coords.x >= width || pixel_coords.y >= height) return;

    vec2 uv = (vec2(pixel_coords) + 0.5) / vec2(width, height);
    
    // 1. 读取 G-Buffer
    vec3 worldPos = texture(gPosition, uv).rgb;
    vec3 normal = texture(gNormal, uv).rgb;

    // 简单的判断：如果 normal 为 0 (无效像素)，则不计算
    if (length(normal) < 0.1) {
        imageStore(outputImage, pixel_coords, vec4(1.0));
        return;
    }

    // 2. 构建射向光源的光线
    // 这里的 lightPos 应该是世界空间中的光源位置
    vec3 lightDir = lightPos - worldPos;
    float distToLight = length(lightDir);
    lightDir = normalize(lightDir);

    // 偏移起点防止自遮挡 (Shadow Acne)
    vec3 origin = worldPos + normal * 0.01;

    Ray shadowRay;
    shadowRay.origin = origin;
    shadowRay.direction = lightDir;
    shadowRay.tMin = 0.001;
    shadowRay.tMax = distToLight; // 只检测光源之前的遮挡

    // 3. 追踪
    bool shadowed = TraceShadowRay(shadowRay);

    // 4. 输出可见性 (1.0 = 可见, 0.0 = 阴影)
    float visibility = shadowed ? 0.0 : 1.0;
    imageStore(outputImage, pixel_coords, vec4(visibility, 0.0, 0.0, 1.0));
}