#version 460 core

layout(local_size_x = 32, local_size_y = 32) in;

const float PI = 3.14159265359;
const float INV_PI = 0.31830988618;
const float MAX_REFLECTION_LOD = 4.0;
// ================== 结构体定义 (保持与 C++ 一致) ==================
struct Ray {
    vec3 origin;
    vec3 direction;
    float tMin;
    float tMax;
};

struct HitRecord {
    vec3 position;
    vec3 normal;
    vec3 tangent;
    vec2 texcoord;
    float pad0, pad1;
    float t;
    uint materialIndex;
    uint triangleIndex;
    bool frontFace;
};

struct Triangle {
    vec3 v0; float pad0;
    vec3 v1; float pad1;
    vec3 v2; float pad2;
    vec3 n0; float pad3;
    vec3 n1; float pad4;
    vec3 n2; float pad5;
    vec3 t0; float padTangent0;
    vec3 t1; float padTangent1;
    vec3 t2; float padTangent2;
    vec2 uv0; vec2 pad6;
    vec2 uv1; vec2 pad7;
    vec2 uv2; vec2 pad8;
    uint materialIndex;
    uint pad9; uint pad10; uint pad11;
};

struct BVHNode {
    vec4 min;
    vec4 max;
    int leftChild;
    int firstPrim;
    int primCount;
    int pad2;
};

struct GPUMaterial {
    vec4 albedo;
    vec4 emissive;
    float metallic;
    float roughness;
    float ao;
    uint albedoTexture;
    uint normalTexture;
    uint metallicTexture;
    uint roughnessTexture;
    uint aoTexture;
    uint emissiveTexture;
    uint pad0; uint pad1; uint pad2; 
};

struct Light {
    vec3 position;  float pad0;
    vec3 direction; float pad1;
    vec3 color;     float intensity;
    float range;
    float constant;
    float linear;
    float quadratic;
    float innerCutoff;
    float outerCutoff;
    int type;       
    float pad2, pad3, pad4;
};

struct SurfaceMaterial {
    vec3 albedo;
    float metallic;
    float roughness;
    float ao;
    vec3 emissive;
    vec3 F0;
};

struct HitInfo {
    float t;
    float u;
    float v;
    int triIndex;
};

// ================== 资源绑定 ==================
layout(std140, binding = 9) uniform LightData {
    int lightCount;
    Light lights[16];
};

layout(std430, binding = 0) buffer RayBuffer { Ray rays[]; };
layout(std430, binding = 1) buffer HitBuffer { HitRecord hits[]; };
layout(std430, binding = 2) buffer OutputBuffer { vec4 outputPixels[]; };
layout(std430, binding = 3) buffer AccumulationBuffer { vec4 accumulationPixels[]; };
layout(std430, binding = 4) readonly buffer BVHNodesBuffer { BVHNode bvhNodes[]; };
layout(std430, binding = 5) readonly buffer TrianglesBuffer { Triangle triangles[]; };
layout(std430, binding = 6) readonly buffer MaterialsBuffer { GPUMaterial materials[]; };

uniform samplerCube irradianceMap;
uniform samplerCube prefilterMap;
uniform sampler2D brdfLUT;
uniform samplerCube environmentMap; 

uniform uint width;
uniform uint height;
uniform uint maxBounces;
uniform uint samplesPerPixel;
uniform uint frameNumber;
uniform sampler2D textureMaps[32];

// ================== 随机数 & 采样工具 ==================
uint WangHash(uint seed) {
    seed = (seed ^ 61) ^ (seed >> 16);
    seed *= 9;
    seed = seed ^ (seed >> 4);
    seed *= 0x27d4eb2d;
    seed = seed ^ (seed >> 15);
    return seed;
}

float RandomFloat(inout uint seed) {
    seed = WangHash(seed);
    return float(seed) * (1.0 / 4294967296.0);
}

// 构建局部坐标系 (TBN)
void BuildOrthonormalBasis(vec3 N, out vec3 T, out vec3 B) {
    vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    T = normalize(cross(up, N));
    B = cross(N, T);
}

// 漫反射重要性采样 (Cosine Weighted Hemisphere)
vec3 SampleCosineHemisphere(vec3 N, inout uint seed) {
    float u1 = RandomFloat(seed);
    float u2 = RandomFloat(seed);
    float r = sqrt(u1);
    float phi = 2.0 * PI * u2;
    vec3 L = vec3(r * cos(phi), r * sin(phi), sqrt(max(0.0, 1.0 - u1)));
    
    vec3 T, B;
    BuildOrthonormalBasis(N, T, B);
    return T * L.x + B * L.y + N * L.z;
}

// 镜面反射重要性采样 (GGX NDF)
vec3 SampleGGX(vec3 N, vec3 V, float roughness, inout uint seed) {
    float a = roughness * roughness;
    float u1 = RandomFloat(seed);
    float u2 = RandomFloat(seed);
    
    float phi = 2.0 * PI * u1;
    float cosTheta = sqrt((1.0 - u2) / (1.0 + (a*a - 1.0) * u2));
    float sinTheta = sqrt(1.0 - cosTheta*cosTheta);
    
    vec3 H = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
    
    vec3 T, B;
    BuildOrthonormalBasis(N, T, B);
    vec3 worldH = T * H.x + B * H.y + N * H.z;
    
    return reflect(-V, worldH);
}

// ================== PBR 基础函数 ==================
float DistributionGGX(vec3 N, vec3 H, float roughness) {
    float a = roughness * roughness;
    float a2 = a * a;
    float NdotH = max(dot(N, H), 0.0);
    float NdotH2 = NdotH * NdotH;
    float denom = (NdotH2 * (a2 - 1.0) + 1.0);
    return a2 / (PI * denom * denom + 1e-6);
}

float GeometrySchlickGGX(float NdotV, float roughness) {
    float r = (roughness + 1.0);
    float k = (r * r) * 0.125;
    return NdotV / (NdotV * (1.0 - k) + k + 1e-6);
}

float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness) {
    return GeometrySchlickGGX(max(dot(N, V), 0.0), roughness) * 
           GeometrySchlickGGX(max(dot(N, L), 0.0), roughness);
}

vec3 FresnelSchlick(float cosTheta, vec3 F0) {
    return F0 + (1.0 - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

vec3 FresnelSchlickRoughness(float cosTheta, vec3 F0, float roughness) {
    return F0 + (max(vec3(1.0 - roughness), F0) - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

// ================== IBL 计算 ==================
vec3 CalculateIBL(vec3 N, vec3 V, vec3 albedo, float roughness, float metallic, float ao) {
    vec3 F0 = mix(vec3(0.04), albedo, metallic);
    vec3 R = reflect(-V, N);

    // 1. 漫反射 (Irradiance)
    vec3 irradiance = texture(irradianceMap, N).rgb;
    vec3 F = FresnelSchlickRoughness(max(dot(N, V), 0.0), F0, roughness);
    
    vec3 kS = F;
    vec3 kD = (1.0 - kS) * (1.0 - metallic);
    vec3 diffuse = kD * irradiance * albedo;

    // 2. 镜面反射 (Prefilter + LUT)
    vec3 prefilteredColor = textureLod(prefilterMap, R, roughness * MAX_REFLECTION_LOD).rgb;
    vec2 envBRDF = texture(brdfLUT, vec2(max(dot(N, V), 0.0), roughness)).rg;
    vec3 specular = prefilteredColor * (F * envBRDF.x + envBRDF.y);

    return (diffuse + specular) * ao;
}

// ================== BVH & 几何 ==================
bool TriangleIntersectGeometry(Triangle tri, Ray ray, float tMax, out float t, out float u, out float v) {
    vec3 edge1 = tri.v1 - tri.v0;
    vec3 edge2 = tri.v2 - tri.v0;
    vec3 h = cross(ray.direction, edge2);
    float a = dot(edge1, h);
    if (abs(a) < 1e-6) return false;
    float f = 1.0 / a;
    vec3 s = ray.origin - tri.v0;
    u = f * dot(s, h);
    if (u < 0.0 || u > 1.0) return false;
    vec3 q = cross(s, edge1);
    v = f * dot(ray.direction, q);
    if (v < 0.0 || u + v > 1.0) return false;
    t = f * dot(edge2, q);
    return (t > 0.001 && t < tMax);
}

// 阴影射线检测 (AnyHit) - 只需知道是否遮挡
bool BVHIntersectAnyHit(Ray ray, float tMax,uint selfTriIdx) {
    vec3 invDir = 1.0 / ray.direction;
    // 使用短栈
    int stack[32]; 
    int stackPtr = 0;
    stack[stackPtr++] = 0;

    while (stackPtr > 0) {
        int nodeIndex = stack[--stackPtr];
        BVHNode node = bvhNodes[nodeIndex];

        vec3 t0 = (node.min.xyz - ray.origin) * invDir;
        vec3 t1 = (node.max.xyz - ray.origin) * invDir;
        vec3 tmin_v = min(t0, t1);
        vec3 tmax_v = max(t0, t1);
        
        float tmin = max(max(tmin_v.x, tmin_v.y), tmin_v.z);
        float tmax = min(min(tmax_v.x, tmax_v.y), tmax_v.z);

        if (tmax < max(tmin, 0.0) || tmin > tMax) continue;

        if (node.primCount > 0) {
            for (int i = 0; i < node.primCount; i++) {
                Triangle tri = triangles[node.firstPrim + i];
                if (node.firstPrim + i == selfTriIdx) continue;// 忽略自相交
                float tempT, tempU, tempV;
                if (TriangleIntersectGeometry(tri, ray, tMax, tempT, tempU, tempV)) return true;
            }
        } else {
            stack[stackPtr++] = node.leftChild;
            stack[stackPtr++] = node.firstPrim; // right child
        }
    }
    return false;
}

// 常规求交 (Nearest Hit)
bool BVHIntersect(Ray ray, float tMax, inout HitInfo info) {
    vec3 invDir = 1.0 / ray.direction;
    int stack[24]; // 适当减小栈大小，减少寄存器压力
    int stackPtr = 0;
    stack[stackPtr++] = 0;
    
    bool hit = false;
    info.t = tMax;
    info.triIndex = -1;
    
    while (stackPtr > 0) {
        int nodeIndex = stack[--stackPtr];
        BVHNode node = bvhNodes[nodeIndex];
        
        if (nodeIndex >= 999999) continue; // 安全检查

        vec3 t0 = (node.min.xyz - ray.origin) * invDir;
        vec3 t1 = (node.max.xyz - ray.origin) * invDir;
        vec3 tmin_v = min(t0, t1);
        vec3 tmax_v = max(t0, t1);
        float tmin = max(max(tmin_v.x, tmin_v.y), tmin_v.z);
        float tmax = min(min(tmax_v.x, tmax_v.y), tmax_v.z);

        if (tmax < max(tmin, 0.001) || tmin > info.t) continue;
        
        if (node.primCount > 0) {
            for (int i = 0; i < node.primCount; i++) {
                Triangle tri = triangles[node.firstPrim + i];
                float t, u, v;
                if (TriangleIntersectGeometry(tri, ray, info.t, t, u, v)) {
                    info.t = t;
                    info.u = u;
                    info.v = v;
                    info.triIndex = node.firstPrim + i;
                    hit = true;
                }
            }
        } else {
            // 简单的距离排序：先访问近的节点 (假设 left 和 right 的包围盒中心)
            // 这里不做复杂计算，只是简单压栈
            stack[stackPtr++] = node.leftChild;
            stack[stackPtr++] = node.firstPrim;
        }
    }
    return hit;
}

// ================== 材质与着色 ==================
vec3 sRGBToLinear(vec3 color) { return pow(color, vec3(2.2)); }

SurfaceMaterial ResolveMaterial(GPUMaterial mat, vec2 uv) {
    SurfaceMaterial surf;
    // 使用 mix 减少分支，或者保持 if 提高缓存命中(如果纹理一致性高)
    // 假设场景纹理一致性一般，保留 if 判断存在性
    
    surf.albedo = mat.albedo.rgb;
    if (mat.albedoTexture > 0) surf.albedo *= sRGBToLinear(texture(textureMaps[mat.albedoTexture], uv).rgb);

    surf.metallic = mat.metallic;
    if (mat.metallicTexture > 0) surf.metallic *= texture(textureMaps[mat.metallicTexture], uv).r;

    surf.roughness = mat.roughness;
    if (mat.roughnessTexture > 0) surf.roughness *= texture(textureMaps[mat.roughnessTexture], uv).r;

    surf.ao = mat.ao;
    if (mat.aoTexture > 0) surf.ao *= texture(textureMaps[mat.aoTexture], uv).r;

    surf.emissive = mat.emissive.rgb * mat.emissive.a; // alpha channel store intensity?
    if (mat.emissiveTexture > 0) surf.emissive *= sRGBToLinear(texture(textureMaps[mat.emissiveTexture], uv).rgb) * 10.0;

    surf.F0 = mix(vec3(0.04), surf.albedo, surf.metallic);
    return surf;
}

vec3 GetShadingNormal(GPUMaterial mat, HitRecord rec) {
    if (mat.normalTexture == 0) return rec.normal;
    vec3 mapNormal = texture(textureMaps[mat.normalTexture], rec.texcoord).rgb * 2.0 - 1.0;
    // Gram-Schmidt process for TBN re-orthogonalization
    vec3 N = normalize(rec.normal);
    vec3 T = normalize(rec.tangent - dot(rec.tangent, N) * N);
    vec3 B = cross(N, T);
    mat3 TBN = mat3(T, B, N);
    return normalize(TBN * mapNormal);
}

// 直接光照 (Next Event Estimation)
// 随机选择一个光源并乘以光源数量（MIS权重）
vec3 CalculateDirectLightStochastic(HitRecord rec, vec3 N, vec3 V, SurfaceMaterial surf, inout uint seed) {
    if (lightCount == 0) return vec3(0.0);
    
    // 随机选择一个光源
    int lightIndex = int(RandomFloat(seed) * float(lightCount));
    lightIndex = min(lightIndex, lightCount - 1); // 防止浮点精度越界
    Light light = lights[lightIndex];
    
    vec3 L;
    float distanceToLight;
    float attenuation = 1.0;
    float spotAttenuation = 1.0;

    if(light.type == 0) { // Directional
        L = normalize(-light.direction);
        distanceToLight = 100000.0; // large but finite
    } else if(light.type == 1) { // Point
        vec3 lightToPos = light.position - rec.position;
        distanceToLight = length(lightToPos);
        L = lightToPos / max(distanceToLight, 0.001);
        
        float d = max(distanceToLight, 0.001);
        attenuation = 1.0 / (light.constant + light.linear * d + light.quadratic * d * d);
    } else { // Spot (type == 2)
        vec3 lightToPos = light.position - rec.position;
        distanceToLight = length(lightToPos);
        L = lightToPos / max(distanceToLight, 0.001);
        
        float d = max(distanceToLight, 0.001);
        attenuation = 1.0 / (light.constant + light.linear * d + light.quadratic * d * d);
        
        // Spot cone attenuation
        float theta = dot(L, normalize(-light.direction));
        float epsilon = light.innerCutoff - light.outerCutoff;
        spotAttenuation = clamp((theta - light.outerCutoff) / max(epsilon, 0.001), 0.0, 1.0);
        attenuation *= spotAttenuation;
    }

    float NdotL = dot(N, L);
    if (NdotL <= 0.0 || attenuation < 1e-4) return vec3(0.0);

    // 阴影射线
    Ray shadowRay;
    shadowRay.origin = rec.position + N * 1e-3;
    shadowRay.direction = L;
    if (BVHIntersectAnyHit(shadowRay, distanceToLight, rec.triangleIndex)) {
        return vec3(0.0);
    }

    // Cook-Torrance BRDF
    vec3 H = normalize(V + L);
    float NDF = DistributionGGX(N, H, surf.roughness);
    float G = GeometrySmith(N, V, L, surf.roughness);
    vec3 F = FresnelSchlick(max(dot(H, V), 0.0), surf.F0);

    vec3 kS = F;
    vec3 kD = (vec3(1.0) - kS) * (1.0 - surf.metallic);

    vec3 numerator = NDF * G * F;
    float denominator = 4.0 * max(dot(N, V), 0.0) * NdotL + 0.001;
    vec3 specular = numerator / denominator;

    vec3 radiance = light.color * light.intensity * attenuation;
    // 乘以光源数量（MIS权重：均匀采样一个光源的PDF为1/lightCount）
    return (kD * surf.albedo * INV_PI + specular) * radiance * NdotL * float(lightCount);
}

// ================== 色调映射 ==================

// ACES Filmic Tone Mapping (approximation by Stephen Hill)
vec3 ACESFilm(vec3 x) {
    float a = 2.51f;
    float b = 0.03f;
    float c = 2.43f;
    float d = 0.59f;
    float e = 0.14f;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

// ================== 核心路径追踪循环 ==================
vec3 TracePath(Ray ray, inout uint seed) {
    vec3 throughput = vec3(1.0);
    vec3 totalRadiance = vec3(0.0);
    
    for (int bounce = 0; bounce < maxBounces; bounce++) {
        HitInfo info;
        // 1. 求交
        if (!BVHIntersect(ray, 10000.0, info)) {
            vec3 skyColor = textureLod(environmentMap, ray.direction, 0.0).rgb; 
            totalRadiance += throughput * skyColor;
            break;
        }

        // 2. 准备表面数据
        Triangle tri = triangles[info.triIndex];
        HitRecord rec;
        rec.position = ray.origin + ray.direction * info.t;
        
        float w = 1.0 - info.u - info.v;
        rec.normal = normalize(tri.n0 * w + tri.n1 * info.u + tri.n2 * info.v);
        rec.texcoord = tri.uv0 * w + tri.uv1 * info.u + tri.uv2 * info.v;
        rec.tangent = normalize(tri.t0 * w + tri.t1 * info.u + tri.t2 * info.v);
        rec.triangleIndex = info.triIndex;
        
        // 双面材质处理
        bool frontFace = dot(ray.direction, rec.normal) < 0.0;
        vec3 normal = frontFace ? rec.normal : -rec.normal;

        GPUMaterial rawMat = materials[tri.materialIndex];
        SurfaceMaterial surf = ResolveMaterial(rawMat, rec.texcoord);
        vec3 shadingNormal = GetShadingNormal(rawMat, HitRecord(rec.position, normal, rec.tangent, rec.texcoord, 0,0,0,0,0, frontFace));

        vec3 V = -ray.direction;

        // 3. 自发光
        if (bounce == 0 || frontFace) {
            totalRadiance += throughput * surf.emissive;
        }

        // 4. 直接光照 (NEE)
        totalRadiance += throughput * CalculateDirectLightStochastic(rec, shadingNormal, V, surf, seed);

        // 5. IBL 优化 (Early Exit)

        if (bounce >= 1 && surf.roughness > 0.3) {
            vec3 ibl = CalculateIBL(shadingNormal, V, surf.albedo, surf.roughness, surf.metallic, surf.ao);
            totalRadiance += throughput * ibl; 
            break; 
        }

        // 6. 俄罗斯轮盘赌 (终止路径)
        float p = max(max(throughput.r, throughput.g), throughput.b);
        if (RandomFloat(seed) > p) break;
        throughput /= p;

        // 7. 采样下一条光线 (间接光)
        // 使用重要性采样选择 Diffuse 还是 Specular
        vec3 F = FresnelSchlick(max(dot(shadingNormal, V), 0.0), surf.F0);
        float specProb = (F.r + F.g + F.b) / 3.0;
        specProb = mix(specProb, 1.0, surf.metallic); // 金属主要是镜面反射
        
        vec3 nextDir;
        if (RandomFloat(seed) < specProb) {
            // Specular Bounce (GGX Importance Sampling)
            nextDir = SampleGGX(shadingNormal, V, surf.roughness, seed);
            throughput *= F; 
        } else {
            // Diffuse Bounce (Cosine Hemisphere Sampling)
            nextDir = SampleCosineHemisphere(shadingNormal, seed);
            throughput *= surf.albedo * (1.0 - surf.metallic); // 漫反射颜色
        }
        
        ray.origin = rec.position + shadingNormal * 1e-3;
        ray.direction = nextDir;
        
        // 保护检查
        if (dot(ray.direction, shadingNormal) <= 0.0) break;
    }
    
    return totalRadiance;
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= width || y >= height) return;
    
    uint pixelIndex = y * width + x;
    uint seed = pixelIndex * 1973 + frameNumber * 26699; // 更好的种子初始化
    
    Ray ray = rays[pixelIndex];
    vec3 color = TracePath(ray, seed);
    
    // NaN / Inf 移除
    if (isnan(color.r) || isinf(color.r)) color = vec3(0.0);

    // 色调映射 (HDR -> LDR)
    color = ACESFilm(color);

    // Gamma校正
    color = pow(color, vec3(1.0 / 2.2));

    // 混合历史帧 (Temporal Accumulation)
    if (frameNumber > 0) {
        vec3 history = accumulationPixels[pixelIndex].rgb;
        float weight = 1.0 / float(frameNumber + 1);
        color = mix(history, color, weight);
    }
    
    outputPixels[pixelIndex] = vec4(color, 1.0);
    accumulationPixels[pixelIndex] = vec4(color, 1.0);
}