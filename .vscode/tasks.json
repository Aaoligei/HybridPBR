{
    "version": "2.0.0",
    "tasks": [
       {
            "label": "cmake: configure",
            "type": "cmake",
            "command": "configure",
            "args": ["-DCMAKE_BUILD_TYPE=Debug"],
            "group": "build"
        },
        {
            "label": "cmake: build",
            "type": "cmake",
            "command": "build",
            "group": "build",
            "dependsOn": "cmake: configure"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe 生成活动文件",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ],
    


}