#version 460 core

layout(local_size_x = 16, local_size_y = 16) in;

layout (std140, binding = 8) uniform CameraData {
    mat4 view;
    mat4 projection;
    vec3 viewPos;
};

// 光源
// 对应 C++ 的 GPULight
struct Light {
    vec3 position;  float pad0;
    vec3 direction; float pad1;
    vec3 color;     float intensity;
    float range;
    float constant;
    float linear;
    float quadratic;
    float innerCutoff;
    float outerCutoff;
    int type;       
    float pad2, pad3, pad4; // 补齐 std140
};

layout (std140, binding = 9) uniform LightData {
    int lightCount;
    Light lights[16];
};


struct Ray {
    vec3 origin;
    vec3 direction;
    float tMin;
    float tMax;
};

layout(std430, binding = 0) buffer RayBuffer {
    Ray rays[];
};

layout(std430, binding = 1) buffer OutputBuffer {
    vec4 outputPixels[];
};

uniform uint width;
uniform uint height;
uniform uint frameNumber;

// 工具函数
vec3 RandomInUnitSphere(uint pixelIndex, uint sampleIndex) {
    // 简化随机数生成
    uint seed = pixelIndex * 1973 + sampleIndex * 9277 + frameNumber * 26699;
    seed = (seed ^ 61) ^ (seed >> 16);
    seed *= 9;
    seed = seed ^ (seed >> 4);
    seed *= 0x27d4eb2d;
    seed = seed ^ (seed >> 15);
    
    float theta = float(seed & 0xFFFF) / 65535.0 * 2.0 * 3.14159265;
    float phi = float((seed >> 16) & 0xFFFF) / 65535.0 * 3.14159265;
    float r = float((seed >> 32) & 0xFFFF) / 65535.0;
    
    return vec3(sin(phi) * cos(theta), sin(phi) * sin(theta), cos(phi)) * r;
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    
    if (x >= width || y >= height) return;
    
    uint pixelIndex = y * width + x;
    
    // 简化相机模型 - 生成主光线
    vec2 uv = vec2(float(x) / float(width), float(y) / float(height));

    // 添加随机性用于抗锯齿
    if (frameNumber > 0) {
        vec2 jitter = vec2(
            float((pixelIndex * 1973 + frameNumber) & 0xFF) / 255.0 - 0.5,
            float((pixelIndex * 9277 + frameNumber) & 0xFF) / 255.0 - 0.5
        ) / float(width);
        
        uv += jitter;
    }
    vec2 d=uv * 2.0 - 1.0;
    // === 核心修复：使用矩阵构建光线 ===
    // 1. 屏幕空间 -> 观察空间
    vec4 target = projection * vec4(d.x, d.y, 1.0, 1.0);
    vec3 rayDirView = normalize(target.xyz / target.w);
    
    // 2. 观察空间 -> 世界空间
    vec3 rayDirWorld = (view * vec4(rayDirView, 0.0)).xyz;
    
    // 存储光线
    rays[pixelIndex].origin = viewPos;
    rays[pixelIndex].direction = normalize(rayDirWorld);
    rays[pixelIndex].tMin = 0.001;
    rays[pixelIndex].tMax = 10000.0;
    
    // 初始化输出像素
    if (frameNumber == 0) {
        outputPixels[pixelIndex] = vec4(0.0);
    }
}